    Args:
    user_message: Takes a user input for which the response should be retrieved from the vectorDB.
    Returns:
    relevant context as per user query.
    """
    relevant_documents_chunks = retriever.get_relevant_documents(user_message)
    context_list = [d.page_context for d in relevant_document_chunks]
    context_for_query=".".join(context_list)
    # Combine qna_system_message and qna_user_message_template to create the prompt
    prompt = f"""[INST]{qna_system_message}\n
                {'user'}: {qna_user_message}
                [/INST]"""
    # Querying the llm
    try:
        response=llm.invoke(prompt)
    except Exception as e:
        response=f'Sorry, I emcountered the following error: \n {e}'
    return response.content
